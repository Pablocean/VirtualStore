# VirtualStore — example environment file. Copy to .env and fill secrets.
# NEVER commit .env (gitignored). All values override appsettings.json via dotenv.net.

MongoDbSettings__ConnectionString=mongodb://localhost:27017
MongoDbSettings__DatabaseName=VirtualStoreDb

JwtSettings__Secret=REPLACE_WITH_64_CHAR_RANDOM_SECRET_MIN_32_CHARS_LONG_000000
JwtSettings__Issuer=VirtualStoreAPI
JwtSettings__Audience=VirtualStoreClient
JwtSettings__AccessTokenExpirationMinutes=15
JwtSettings__RefreshTokenExpirationDays=7

EmailSettings__SmtpServer=smtp.example.com
EmailSettings__Port=587
EmailSettings__SenderEmail=no-reply@virtualstore.com
EmailSettings__SenderName=Virtual Store
EmailSettings__Username=smtp-user
EmailSettings__Password=smtp-password
EmailSettings__EnableSsl=true

StripeSettings__SecretKey=sk_test_REPLACE_ME
StripeSettings__PublishableKey=pk_test_REPLACE_ME
StripeSettings__WebhookSecret=whsec_REPLACE_ME

DatabaseSeeder__AdminEmail=admin@virtualstore.com
DatabaseSeeder__AdminPassword=ChangeMe123!
DatabaseSeeder__AdminUsername=admin

CorsSettings__AllowedOrigins__0=http://localhost:3000
