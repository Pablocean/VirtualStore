@VirtualStore.API_HostAddress = http://localhost:5293

### Create an order (server-side pricing, stock checked; 201 on success)
POST {{VirtualStore.API_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "items": [
    { "productId": "PRODUCT_ID_HERE", "productName": "IgnoredByServer", "unitPrice": 0.01, "quantity": 2 }
  ],
  "shippingAddress": {
    "street": "123 Main St",
    "city": "Springfield",
    "state": "IL",
    "zipCode": "62701",
    "country": "USA"
  }
}

### Create an order with empty cart items (error path -> 400/409)
POST {{VirtualStore.API_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "items": [],
  "shippingAddress": {
    "street": "123 Main St",
    "city": "Springfield",
    "state": "IL",
    "zipCode": "62701",
    "country": "USA"
  }
}

### Get my orders, paged
GET {{VirtualStore.API_HostAddress}}/api/orders/my?pageNumber=1&pageSize=20
Authorization: Bearer {{token}}

### Get one order (owner or admin; others -> 403, unknown id -> 404)
GET {{VirtualStore.API_HostAddress}}/api/orders/ORDER_ID_HERE
Authorization: Bearer {{token}}

### Update order status (Admin only; illegal transition -> 409/500, unknown id -> 404)
PATCH {{VirtualStore.API_HostAddress}}/api/orders/ORDER_ID_HERE/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": "Processing"
}

### Get enterprise info (anonymous)
GET {{VirtualStore.API_HostAddress}}/api/enterprise-info
Accept: application/json

### Update enterprise info (Admin only)
PUT {{VirtualStore.API_HostAddress}}/api/enterprise-info
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "companyName": "VirtualStore Inc.",
  "address": "123 Commerce St, Springfield, IL",
  "phone": "+1-555-0100",
  "email": "info@virtualstore.example",
  "aboutUs": "Demo storefront."
}

### Create a payment intent (authenticated)
POST {{VirtualStore.API_HostAddress}}/api/payments/intent
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 49.99,
  "currency": "usd",
  "orderId": "ORDER_ID_HERE"
}

### Refund an order payment (Admin only; order without payment -> 400, unknown id -> 404)
POST {{VirtualStore.API_HostAddress}}/api/payments/orders/ORDER_ID_HERE/refund
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "amount": 49.99
}

### Full refund (no body amount)
POST {{VirtualStore.API_HostAddress}}/api/payments/orders/ORDER_ID_HERE/refund
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{}

### Stripe webhook (anonymous; bad signature -> 400)
POST {{VirtualStore.API_HostAddress}}/api/stripe/webhook
Content-Type: application/json
Stripe-Signature: t=1492774577,v1=INVALID_SIGNATURE_FOR_TESTING

{
  "id": "evt_test_123",
  "object": "event",
  "type": "payment_intent.succeeded"
}

### List categories, paged (anonymous)
GET {{VirtualStore.API_HostAddress}}/api/categories?pageNumber=1&pageSize=20
Accept: application/json

### Get category by id (unknown id -> 404)
GET {{VirtualStore.API_HostAddress}}/api/categories/CATEGORY_ID_HERE
Accept: application/json

### Create a category (Admin/Manager only)
POST {{VirtualStore.API_HostAddress}}/api/categories
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Electronics",
  "description": "Gadgets and devices"
}

### Update a category (Admin/Manager only; unknown id -> 404)
PUT {{VirtualStore.API_HostAddress}}/api/categories/CATEGORY_ID_HERE
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Electronics & Gadgets",
  "description": "Updated description",
  "isActive": true
}

### Delete a category (Admin only -> 204, unknown id -> 404)
DELETE {{VirtualStore.API_HostAddress}}/api/categories/CATEGORY_ID_HERE
Authorization: Bearer {{adminToken}}

### Confirm email (200 on success, 409 on bad/expired token)
POST {{VirtualStore.API_HostAddress}}/api/auth/confirm-email
Content-Type: application/json

{
  "email": "user@virtualstore.example",
  "token": "CONFIRM_TOKEN_HERE"
}

### Resend confirmation (always 200 generic, no enumeration)
POST {{VirtualStore.API_HostAddress}}/api/auth/resend-confirmation
Content-Type: application/json

{
  "email": "user@virtualstore.example"
}

### Change password (auth; revokes all refresh tokens)
POST {{VirtualStore.API_HostAddress}}/api/auth/change-password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPassword": "OldPass123",
  "newPassword": "NewPass123"
}

### Forgot password (always 200 generic, no enumeration)
POST {{VirtualStore.API_HostAddress}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "user@virtualstore.example"
}

### Reset password (200 on success, 409 on bad/expired token; revokes all sessions)
POST {{VirtualStore.API_HostAddress}}/api/auth/reset-password
Content-Type: application/json

{
  "email": "user@virtualstore.example",
  "token": "RESET_TOKEN_HERE",
  "newPassword": "BrandNew123"
}

### Login (200 TokenResponse + refreshToken cookie; 2FA accounts get requiresTwoFactor:true first)
POST {{VirtualStore.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@virtualstore.example",
  "password": "Admin123!"
}

### Login second step for 2FA accounts (same credentials + 6-digit OTP from email)
POST {{VirtualStore.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@virtualstore.example",
  "password": "Admin123!",
  "otpCode": "123456"
}

### Refresh token (reads refreshToken cookie; rotates it; reuse of old token -> 401 + all revoked)
POST {{VirtualStore.API_HostAddress}}/api/auth/refresh-token
Authorization: Bearer {{token}}

### Logout (requires BOTH Bearer token and refreshToken cookie; clears the cookie)
POST {{VirtualStore.API_HostAddress}}/api/auth/logout
Authorization: Bearer {{token}}

### List users, paged (Admin only)
GET {{VirtualStore.API_HostAddress}}/api/users?search=&pageNumber=1&pageSize=20
Authorization: Bearer {{adminToken}}

### Create a user (Admin only -> 200, not 201; roles non-empty, password >=8 + upper/lower/digit)
POST {{VirtualStore.API_HostAddress}}/api/users
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "email": "staff@virtualstore.example",
  "username": "staff01",
  "password": "Staff1234",
  "firstName": "Sam",
  "roles": ["Manager"]
}

### Update a user (Admin only; all-optional)
PUT {{VirtualStore.API_HostAddress}}/api/users/USER_ID_HERE
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "twoFactorEnabled": true
}

### Soft-delete a user (Admin only -> 204; GDPR erasure is POST /api/me/purge instead)
DELETE {{VirtualStore.API_HostAddress}}/api/users/USER_ID_HERE
Authorization: Bearer {{adminToken}}

### Export own data (any authenticated role; no secrets in the payload)
GET {{VirtualStore.API_HostAddress}}/api/me/export
Authorization: Bearer {{token}}

### GDPR purge/erase own account (current password required -> 200 counts; wrong password -> 401)
POST {{VirtualStore.API_HostAddress}}/api/me/purge
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "confirmPassword": "Staff1234"
}

### List products, paged (anonymous; isActive defaults to true — omit for all)
GET {{VirtualStore.API_HostAddress}}/api/products?search=&minPrice=&maxPrice=&isActive=true&pageNumber=1&pageSize=20
Accept: application/json

### Get product by id (unknown id -> empty 404)
GET {{VirtualStore.API_HostAddress}}/api/products/PRODUCT_ID_HERE
Accept: application/json

### Create a product (Admin/Manager -> 201 + Location; single imageUrl)
POST {{VirtualStore.API_HostAddress}}/api/products
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "name": "Demo Widget",
  "description": "A demo product.",
  "price": 19.99,
  "currency": "usd",
  "stockQuantity": 50,
  "imageUrl": "https://example.com/img/widget.png",
  "categoryId": "CATEGORY_ID_HERE",
  "tags": ["demo"]
}

### Update a product (Admin/Manager; all-optional incl. isActive)
PUT {{VirtualStore.API_HostAddress}}/api/products/PRODUCT_ID_HERE
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "price": 17.99,
  "stockQuantity": 60
}

### Delete a product (Admin only -> 204)
DELETE {{VirtualStore.API_HostAddress}}/api/products/PRODUCT_ID_HERE
Authorization: Bearer {{adminToken}}

### Get cart (authenticated; identity from claims)
GET {{VirtualStore.API_HostAddress}}/api/cart
Authorization: Bearer {{token}}

### Add item to cart (quantity 1-99, default 1)
POST {{VirtualStore.API_HostAddress}}/api/cart/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "productId": "PRODUCT_ID_HERE",
  "quantity": 2
}

### Update item quantity (raw JSON number body, NOT an object; clamp 1-99 client-side)
PUT {{VirtualStore.API_HostAddress}}/api/cart/items/PRODUCT_ID_HERE
Content-Type: application/json
Authorization: Bearer {{token}}

3

### Remove item from cart
DELETE {{VirtualStore.API_HostAddress}}/api/cart/items/PRODUCT_ID_HERE
Authorization: Bearer {{token}}

### Clear cart (-> 204)
DELETE {{VirtualStore.API_HostAddress}}/api/cart
Authorization: Bearer {{token}}

### Create an order with Idempotency-Key header (header wins over body; replay -> 201 same order)
POST {{VirtualStore.API_HostAddress}}/api/orders
Content-Type: application/json
Authorization: Bearer {{token}}
Idempotency-Key: 11111111-2222-3333-4444-555555555555

{
  "items": [
    { "productId": "PRODUCT_ID_HERE", "productName": "", "unitPrice": 0, "quantity": 1 }
  ],
  "shippingAddress": {
    "street": "123 Main St",
    "city": "Springfield",
    "state": "IL",
    "zipCode": "62701",
    "country": "USA"
  }
}

### Health readiness (anonymous, rate-limit exempt, includes MongoDB check)
GET {{VirtualStore.API_HostAddress}}/health
Accept: application/json

### Health liveness (anonymous, always Healthy)
GET {{VirtualStore.API_HostAddress}}/health/live
Accept: application/json

###
